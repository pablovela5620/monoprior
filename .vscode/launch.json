{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Polycam Inference",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/inference_polycam.py",
            "console": "integratedTerminal",
            "args": [
                "--zip-path",
                "data/example-room-scan-poly.zip",
            ]
        },
        {
            "name": "VGGT Inference",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/run_multiview_depth.py",
            "console": "integratedTerminal",
            "args": [
                "--confidence-threshold",
                "30",
                "--image-dir",
                "data/portrait_img/"
            ]
        },
        {
            "name": "VDA Inference",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/run_video_da.py",
            "console": "integratedTerminal",
            // "args": [
            //     "--zip-path",
            //     "data/example-room-scan-poly.zip",
            // ]
        },
        {
            "name": "Gradio App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/new_gradio_app.py",
            "console": "integratedTerminal",
        }
    ]
}